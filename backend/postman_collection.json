{
  "info": {
    "name": "API Usuários - Auth JWT",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Cadastrar Usuário",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{base_url}}/usuarios", "host": ["{{base_url}}"], "path": ["usuarios"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"João\",\n  \"email\": \"joao@email.com\",\n  \"senha\": \"123456\",\n  \"perfil\": \"admin\"\n}"
        }
      }
    },
    {
      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "if (json.token) {",
              "  pm.collectionVariables.set('token', json.token);",
              "  console.log('Token salvo automaticamente.');",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{base_url}}/login", "host": ["{{base_url}}"], "path": ["login"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"teste@gmail.com\",\n  \"senha\": \"123456\"\n}"
        }
      }
    },
    {
      "name": "Ver Perfil (protegido)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": { "raw": "{{base_url}}/perfil", "host": ["{{base_url}}"], "path": ["perfil"] }
      }
    },
    {
      "name": "Listar Usuários (protegido)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": { "raw": "{{base_url}}/usuarios", "host": ["{{base_url}}"], "path": ["usuarios"] }
      }
    },
    {
      "name": "Atualizar Usuário (protegido)",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": { "raw": "{{base_url}}/usuarios/1", "host": ["{{base_url}}"], "path": ["usuarios", "1"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"João Atualizado\",\n  \"email\": \"joao.novo@email.com\"\n}"
        }
      }
    },
    {
      "name": "Deletar Usuário (protegido)",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": { "raw": "{{base_url}}/usuarios/1", "host": ["{{base_url}}"], "path": ["usuarios", "1"] }
      }
    }
  ]
}
